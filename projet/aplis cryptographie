def pgcd(a, b):
    while b != 0:
        a, b = b, a % b
    return a


def cle_valide(a):
    return pgcd(a, 26) == 1



def sans_accents(message):
    message = unicodedata.normalize("NFD", message.upper())
    resultat = ""
    for caractere in message:
        if unicodedata.category(caractere) != "Mn":
            resultat += caractere
    return resultat



def chiffrer(message, a, b):
    message = sans_accents(message)
    resultat = ""
    for lettre in message:
        if lettre in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
            x = ord(lettre) - ord('A')
            y = (a * x + b) % 26
            resultat += chr(y + ord('A'))
        else:
            resultat += lettre
    return resultat



def dechiffrer(message, a, b):
    if not cle_valide(a):
        return "Erreur : clé invalide."
    message = sans_accents(message)
    resultat = ""
    inverse = pow(a, -1, 26)
    for lettre in message:
        if lettre in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
            y = ord(lettre) - ord('A')
            x = (inverse * (y - b)) % 26
            resultat += chr(x + ord('A'))
        else:
            resultat += lettre
    return resultat



def afficher_cles():
    print("\n========== CLES VALIDES ==========")
    nombre = 0
    for a in range(26):
        if cle_valide(a):
            for b in range(26):
                print("a =", a, "| b =", b)
                nombre += 1
    print("\nNombre total de clés valides :", nombre)



def occurrence(texte):
    texte = sans_accents(texte)
    dictionnaire = {}
    for lettre in texte:
        if lettre in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":
            if lettre in dictionnaire:
                dictionnaire[lettre] += 1
            else:
                dictionnaire[lettre] = 1
    total = sum(dictionnaire.values())
    probabilites = {}
    if total == 0:
        return probabilites
    for lettre in dictionnaire:
        probabilites[lettre] = dictionnaire[lettre] / total * 100
    return probabilites


def afficher_frequences(texte):

    probabilites = occurrence(texte)

    print("\n========== FREQUENCES DES LETTRES ==========")

    if not probabilites:
        print("Aucune lettre à analyser.")
        return

    for lettre, probabilite in sorted(
        probabilites.items(),
        key=lambda element: element[1],
        reverse=True
    ):
        print(lettre, ":", round(probabilite, 2), "%")



def score_frequences(message, reference):
    """Compare les fréquences du message avec celles de la référence."""

    frequences_reference = occurrence(reference)

    frequences_message = occurrence(message)

    if not frequences_reference:
        return float("inf")

    score = 0

    for lettre in "ABCDEFGHIJKLMNOPQRSTUVWXYZ":

        frequence_ref = frequences_reference.get(lettre, 0)

        frequence_msg = frequences_message.get(lettre, 0)

        score += (frequence_ref - frequence_msg) ** 2

    return score



def force_brute(message, reference):
    """Teste toutes les clés et classe les résultats."""

    resultats = []

    print("\nAnalyse en cours...")

    for a in range(26):

        if cle_valide(a):

            for b in range(26):

                resultat = dechiffrer(message, a, b)

                score = score_frequences(resultat, reference)

                resultats.append((score, a, b, resultat))

    # Classement du meilleur score au moins bon
